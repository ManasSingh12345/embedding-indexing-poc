NGC_API_KEY=
HF_TOKEN=
S3_BUCKET=
AWS_DEFAULT_REGION=us-east-2
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
REMOTE_INDEX_BUILDER_IMAGE=opensearchproject/remote-vector-index-builder:api-latest
# Internal NGC image from NVIDIA/cuvs#2013:
# REMOTE_INDEX_BUILDER_IMAGE=nvcr.io/r2kuatviomfd/internal-sandbox/opensearchproject-remote-vector-index-builder:api-latest
MAX_WORKERS=1
NVIDIA_VISIBLE_DEVICES=0
NIM_MODEL_NAME=nvidia/llama-nemotron-embed-vl-1b-v2
IMG_NAME=nvcr.io/nim/nvidia/llama-nemotron-embed-vl-1b-v2:2.3.0
NIM_PORT=8000
# 1 = throughput defaults (pipeline batch 64). 0 = latency defaults.
NIM_PERFORMANCE_MODE=1
OPENSEARCH_URL=http://127.0.0.1:9200
REMOTE_INDEX_BUILDER_URL=http://127.0.0.1:1025
REMOTE_VECTOR_REPOSITORY=vector-repo
S3_PREFIX=knn-indexes
# OpenSearch sleeps 3× this before the first CAGRA status poll (default 5s → ~15s/flush).
REMOTE_BUILD_POLL_INTERVAL=200ms
# OpenSearch _bulk: larger NDJSON + parallel POSTs (orjson in run_e2e.py).
BULK_DOCS=1000
BULK_WORKERS=4
# 1 = one index and one remote build. Higher values flush that many indices at once.
FLUSH_PARALLEL=1
